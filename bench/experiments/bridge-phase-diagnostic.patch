+/* Called once, only after the worker loop and its normal cleanup. Not an exit
+ * callback: crashes, FATAL exits and postmaster-death exits need not report. */
+void
+echoo_db_report_bridge_diagnostic(void)
+{
+#define COMPLETE_FORMAT "{\"completed\":" UINT64_FORMAT ",\"begin_us\":%.6f,\"work_us\":%.6f,\"commit_us\":%.6f}"
+#define COMPLETE_ARGS(category) \
+    bridge_diagnostic.complete[category].completed, \
+    INSTR_TIME_GET_DOUBLE(bridge_diagnostic.complete[category].begin) * 1000000.0, \
+    INSTR_TIME_GET_DOUBLE(bridge_diagnostic.complete[category].work) * 1000000.0, \
+    INSTR_TIME_GET_DOUBLE(bridge_diagnostic.complete[category].commit) * 1000000.0
+#define ERROR_FORMAT "{\"begin\":" UINT64_FORMAT ",\"work\":" UINT64_FORMAT ",\"commit\":" UINT64_FORMAT "}"
+#define ERROR_ARGS(operation) \
+    bridge_diagnostic.errors[operation][ECHOO_BRIDGE_BEGIN], \
+    bridge_diagnostic.errors[operation][ECHOO_BRIDGE_WORK], \
+    bridge_diagnostic.errors[operation][ECHOO_BRIDGE_COMMIT]
+    ereport(LOG,
+            (errmsg("echoo_pgmq bridge_phase_diag_v1 {"
+                    "\"scope\":\"worker_lifetime_including_warmup_and_drain\","
+                    "\"normal_exit\":true,\"worker_pid\":%d,"
+                    "\"publish\":" COMPLETE_FORMAT ","
+                    "\"claim_empty\":" COMPLETE_FORMAT ","
+                    "\"claim_success\":" COMPLETE_FORMAT ","
+                    "\"settle\":" COMPLETE_FORMAT ","
+                    "\"started\":{\"publish\":" UINT64_FORMAT
+                    ",\"claim\":" UINT64_FORMAT ",\"settle\":" UINT64_FORMAT "},"
+                    "\"settle_outcome\":{\"applied\":" UINT64_FORMAT
+                    ",\"not_applied\":" UINT64_FORMAT "},"
+                    "\"errors\":{\"publish\":" ERROR_FORMAT ","
+                    "\"claim\":" ERROR_FORMAT ",\"settle\":" ERROR_FORMAT "},"
+                    "\"authorization_excluded\":{\"completed\":" UINT64_FORMAT
+                    ",\"errors\":" UINT64_FORMAT "},\"counter_saturated\":%s}",
+                    MyProcPid,
+                    COMPLETE_ARGS(ECHOO_BRIDGE_PUBLISH),
+                    COMPLETE_ARGS(ECHOO_BRIDGE_CLAIM_EMPTY),
+                    COMPLETE_ARGS(ECHOO_BRIDGE_CLAIM_SUCCESS),
+                    COMPLETE_ARGS(ECHOO_BRIDGE_SETTLE),
+                    bridge_diagnostic.started[ECHOO_BRIDGE_OP_PUBLISH],
+                    bridge_diagnostic.started[ECHOO_BRIDGE_OP_CLAIM],
+                    bridge_diagnostic.started[ECHOO_BRIDGE_OP_SETTLE],
+                    bridge_diagnostic.settle_applied,
+                    bridge_diagnostic.settle_not_applied,
+                    ERROR_ARGS(ECHOO_BRIDGE_OP_PUBLISH),
+                    ERROR_ARGS(ECHOO_BRIDGE_OP_CLAIM),
+                    ERROR_ARGS(ECHOO_BRIDGE_OP_SETTLE),
+                    bridge_diagnostic.authorization_completed,
+                    bridge_diagnostic.authorization_errors,
+                    bridge_diagnostic.counter_saturated ? "true" : "false")));
+#undef COMPLETE_FORMAT
+#undef COMPLETE_ARGS
+#undef ERROR_FORMAT
+#undef ERROR_ARGS
+}
