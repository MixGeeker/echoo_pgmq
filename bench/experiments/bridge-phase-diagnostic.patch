@@ -0,0 +1,81 @@
+/* Isolated diagnostic only. No shared state, allocation or per-call logging. */
+#ifndef ECHOO_BRIDGE_PHASE_DIAG_H
+#define ECHOO_BRIDGE_PHASE_DIAG_H
+
+#include "portability/instr_time.h"
+
+typedef enum EchooBridgeCategory
+{
+    ECHOO_BRIDGE_PUBLISH,
+    ECHOO_BRIDGE_CLAIM_EMPTY,
+    ECHOO_BRIDGE_CLAIM_SUCCESS,
+    ECHOO_BRIDGE_SETTLE,
+    ECHOO_BRIDGE_CATEGORY_COUNT
+} EchooBridgeCategory;
+
+typedef enum EchooBridgeOperation
+{
+    ECHOO_BRIDGE_OP_PUBLISH,
+    ECHOO_BRIDGE_OP_CLAIM,
+    ECHOO_BRIDGE_OP_SETTLE,
+    ECHOO_BRIDGE_OPERATION_COUNT
+} EchooBridgeOperation;
+
+typedef enum EchooBridgePhase
+{
+    ECHOO_BRIDGE_BEGIN,
+    ECHOO_BRIDGE_WORK,
+    ECHOO_BRIDGE_COMMIT,
+    ECHOO_BRIDGE_PHASE_COUNT
+} EchooBridgePhase;
+
+typedef struct EchooBridgeTotals
+{
+    uint64 completed;
+    instr_time begin;
+    instr_time work;
+    instr_time commit;
+} EchooBridgeTotals;
+
+typedef struct EchooBridgeDiagnostic
+{
+    EchooBridgeTotals complete[ECHOO_BRIDGE_CATEGORY_COUNT];
+    uint64 started[ECHOO_BRIDGE_OPERATION_COUNT];
+    uint64 errors[ECHOO_BRIDGE_OPERATION_COUNT][ECHOO_BRIDGE_PHASE_COUNT];
+    uint64 settle_applied;
+    uint64 settle_not_applied;
+    uint64 authorization_completed;
+    uint64 authorization_errors;
+    bool counter_saturated;
+} EchooBridgeDiagnostic;
+
+static inline void
+echoo_bridge_diag_increment(EchooBridgeDiagnostic *diagnostic, uint64 *counter)
+{
+    if (*counter == PG_UINT64_MAX)
+        diagnostic->counter_saturated = true;
+    else
+        ++*counter;
+}
+
+/* All four timestamps are read only after successful commit, never in CATCH.
+ * Keep native ticks during collection; convert only in the exit summary. */
+static inline void
+echoo_bridge_diag_complete(EchooBridgeDiagnostic *diagnostic,
+                           EchooBridgeCategory category, const instr_time stamps[4])
+{
+    EchooBridgeTotals *totals = &diagnostic->complete[category];
+    echoo_bridge_diag_increment(diagnostic, &totals->completed);
+    INSTR_TIME_ACCUM_DIFF(totals->begin, stamps[1], stamps[0]);
+    INSTR_TIME_ACCUM_DIFF(totals->work, stamps[2], stamps[1]);
+    INSTR_TIME_ACCUM_DIFF(totals->commit, stamps[3], stamps[2]);
+}
+
+static inline void
+echoo_bridge_diag_error(EchooBridgeDiagnostic *diagnostic,
+                        EchooBridgeOperation operation, EchooBridgePhase phase)
+{
+    echoo_bridge_diag_increment(diagnostic, &diagnostic->errors[operation][phase]);
+}
+
+#endif
