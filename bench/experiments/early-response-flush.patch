diff --git a/tests/test_amqp_integration.py b/tests/test_amqp_integration.py
index 22d3738..9a5120e 100644
--- a/tests/test_amqp_integration.py
+++ b/tests/test_amqp_integration.py
@@ -294,3 +294,25 @@ def test_presettled_publisher_is_refused(admin, queue, connect_amqp):
     with pytest.raises(ProtonException):
         connection.create_sender(queue, options=AtMostOnce())
     assert count(admin, queue) == 0
+
+
+def test_duplex_connection_binary_roundtrips(admin, queue, connect_amqp):
+    """Normal 32 KiB duplex traffic; this does not prove socket backpressure."""
+    connection = connect_amqp()
+    sender = connection.create_sender(queue)
+    for i in range(3):
+        receiver = connection.create_receiver(queue, credit=1)
+        body = bytes([i]) * 32768
+        message = Message(body=body, id=f"duplex-{i}", durable=True)
+        assert sender.send(message, timeout=5).remote_state == Delivery.ACCEPTED
+        received = receiver.receive(timeout=5)
+        assert received.body == body
+        assert received.id == f"duplex-{i}"
+        receiver.accept()
+        # Link close is a protocol barrier which flushes this ACK. A database
+        # predicate is not a network event and can leave BlockingConnection.wait
+        # asleep until its full timeout even after durable deletion succeeds.
+        receiver.close()
+        eventually(lambda: count(admin, queue) == 0)
+    sender.close()
+    eventually(lambda: count(admin, queue) == 0)
